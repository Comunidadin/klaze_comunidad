# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: nunca subas claves al repositorio.
#
# Dónde se sacan: Supabase Dashboard -> tu proyecto -> Project Settings
# -> API Keys.

# URL del proyecto. Tiene la forma https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PUBLICABLE (empieza por `sb_publishable_`). Es pública a propósito:
# viaja al navegador y no concede nada que las políticas RLS no permitan.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NUNCA pongas aquí la clave secreta (`sb_secret_`). Cualquier variable que
# empiece por NEXT_PUBLIC_ se envía al navegador de todos tus alumnos.
# La clave secreta solo irá, más adelante, en variables del servidor para
# las pocas operaciones privilegiadas (alta de empresas, envío de correos).
