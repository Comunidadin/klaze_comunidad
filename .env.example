# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore: nunca subas claves al repositorio.
#
# Dónde se sacan: Supabase Dashboard -> tu proyecto -> Project Settings
# -> API Keys.

# URL del proyecto. Tiene la forma https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PUBLICABLE (empieza por `sb_publishable_`). Es pública a propósito:
# viaja al navegador y no concede nada que las políticas RLS no permitan.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Solo servidor. Ninguna de estas lleva NEXT_PUBLIC_ -----------------
# Cualquier variable que empiece por NEXT_PUBLIC_ se envía al navegador de
# todos tus alumnos. Estas tres, ahí, serían una filtración.

# Clave SECRETA de Supabase (`sb_secret_`). Se salta todas las políticas RLS.
# La usan las pruebas, el alta de academias y el envío de invitaciones.
SUPABASE_SECRET_KEY=

# Conexión directa a Postgres, para aplicar migraciones con `bun run db:push`.
# Project Settings -> Database -> Connection string. La contraseña va
# codificada para URL (@ -> %40).
SUPABASE_DB_URL=

# Envío de correo. La clave permite mandar en nombre de tu dominio, así que
# quien la tenga puede suplantar a tu academia.
RESEND_API_KEY=
# El dominio del remitente debe estar verificado en Resend, o el correo solo
# llegará a la dirección de tu propia cuenta.
RESEND_FROM="Mi Academia <acceso@midominio.com>"

# Asistente de IA por clase. Solo servidor: la clave nunca con NEXT_PUBLIC_.
# El nombre exacto del modelo conviene confirmarlo en la documentación de
# OpenAI — cambian con frecuencia.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Preguntas por alumno y día. Es el techo de la factura.
IA_TOPE_DIARIO=20
# `false` apaga el asistente en toda la plataforma sin desplegar nada.
IA_ACTIVA=true
